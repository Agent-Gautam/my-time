# Supabase Postgres — pooler connection string (serverless-safe)
DATABASE_URL=

# Web Push (VAPID keypair) — generate with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact identity required by the Web Push protocol, e.g. mailto:you@example.com
VAPID_SUBJECT=

# Shared secret checked by /api/cron/remind (D37b)
CRON_SECRET=

# Shared key for /api/sync (D59). BOTH must be set to the SAME value, or sync stops.
#
# This is not authentication. NEXT_PUBLIC_ ships the value in the JS bundle, so it is
# readable by anyone who looks — it deters crawlers and drive-by requests, nothing more.
# Leave both blank to keep the endpoint fully open: the server check is skipped entirely
# when SYNC_KEY is unset, so a half-configured deployment fails open rather than
# wedging every client's outbox.
#
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
SYNC_KEY=
NEXT_PUBLIC_SYNC_KEY=
